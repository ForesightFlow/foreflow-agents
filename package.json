{
  "name": "foreflow-agents",
  "version": "0.2.0",
  "description": "Five on-chain forecasting agents wrapping the coordination-experiment configurations with ERC-8004 commit-reveal on Polygon via the foresight-arena SDK",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check-wallets": "tsc && node dist/ops/check_wallets.js",
    "healthcheck": "tsc && node dist/ops/healthcheck.js",
    "start:ensemble": "node dist/agents/foreflow-ensemble/agent.js",
    "start:debate": "node dist/agents/foreflow-debate/agent.js",
    "start:orchestrator": "node dist/agents/foreflow-orchestrator/agent.js",
    "start:pipeline": "node dist/agents/foreflow-pipeline/agent.js",
    "start:consensus": "node dist/agents/foreflow-consensus/agent.js",
    "start:all": "bash ops/deploy.sh",
    "start:all:live": "bash ops/deploy.sh --live",
    "clean": "rm -rf dist logs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "coordination-experiment": "github:ForesightFlow/coordination-experiment#paper-v05",
    "foresight-arena": "^0.1.6",
    "viem": "^2.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "author": "Maksym Nechepurenko, Pavel Shuvalov",
  "license": "MIT"
}
