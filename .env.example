# Anthropic API — required for predict/all modes
ANTHROPIC_API_KEY=sk-ant-...

# foresight-arena SDK overrides (optional; defaults shown)
# RELAYER_URL=https://api.foresightarena.xyz
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/.../foresight-arena/version/latest
# CHAIN_ID=137    # 137=Polygon mainnet (default), 80002=amoy testnet

# Web search backend
# - "anthropic" (default): Anthropic native web_search_20260209, billed via Anthropic API
# - "tavily": Tavily HTTP API (requires TAVILY_API_KEY below)
WEB_SEARCH_BACKEND=anthropic

# Required only if WEB_SEARCH_BACKEND=tavily
TAVILY_API_KEY=

# Run mode: discover | predict | all (default: all)
# MODE=all

# Predict fires when commitDeadline is within this many seconds (default: 600)
# LEAD_TIME_SECONDS=600

# Dry-run: set to "false" or pass --live to enable on-chain transactions.
# Default is dry-run (safe). Dry-run works without wallet keys set.
# DRY_RUN=false

# Per-agent private keys — populated by foreflow-agents-engine register-all command.
# Not needed for dry-run testing. Keys must be pre-registered on Foresight Arena.
FOREFLOW_ENSEMBLE_AGENT_KEY=0x...
FOREFLOW_DEBATE_AGENT_KEY=0x...
FOREFLOW_ORCHESTRATOR_AGENT_KEY=0x...
FOREFLOW_PIPELINE_AGENT_KEY=0x...
FOREFLOW_CONSENSUS_AGENT_KEY=0x...
